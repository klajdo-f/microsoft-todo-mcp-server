{
  "name": "microsoft-todo-mcp-server",
  "version": "1.1.3",
  "description": "Microsoft Todo MCP service. Fork of @jhirono/todomcp",
  "main": "dist/interface/server.js",
  "dependencies": {
    "@azure/msal-node": "^3.8.10",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.68-alpha.11"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "build:win": "tsup && node -e \"console.log('Build complete')\"",
    "start": "node dist/cli.js",
    "cli": "node dist/cli.js",
    "dev": "pnpm run build && node dist/cli.js",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\" \"*.{json,md}\"",
    "lint": "pnpm run format:check",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run format:check && pnpm run typecheck",
    "check:fix": "pnpm run format && pnpm run typecheck",
    "ci": "pnpm run check && pnpm run build",
    "precommit": "pnpm run check:fix && pnpm run build",
    "prepublishOnly": "pnpm run ci"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klajdo-f/microsoft-todo-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "microsoft-todo",
    "todo"
  ],
  "author": "Klajdo Fyraj <klajdo.fyraj@hexagonal-engineering.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/klajdo-f/microsoft-todo-mcp-server/issues"
  },
  "homepage": "https://github.com/klajdo-f/microsoft-todo-mcp-server#readme",
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "type": "module",
  "bin": {
    "ms-todo": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.21.0+sha512.da3337267e400fdd3d479a6c68079ac6db01d8ca4f67572083e722775a796788a7a9956613749e000fac20d424b594f7a791a5f4e2e13581c5ef947f26968a40"
}
